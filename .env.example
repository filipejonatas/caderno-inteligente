# Backend only. Use the Supabase Transaction Pooler URL on port 6543.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Origens exatas do frontend (esquema + domínio, sem caminho e sem curinga), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# development (padrão local) mostra a causa técnica dos erros; production retorna mensagens genéricas com código de referência.
APP_ENV=development
# true exibe o aviso de publicação de demonstração (dados fictícios que podem ser apagados).
DEMO_MODE=false
# false bloqueia decisões, casos e execuções (HTTP 403); consultas e simulações continuam disponíveis.
WRITE_ENABLED=true
